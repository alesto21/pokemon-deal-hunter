# Copy to .env and fill in. NEVER commit .env. `python -m app.cli setup` can write it for you.

# --- Database (docker compose builds DATABASE_URL from these) ---
POSTGRES_USER=dealhunter
POSTGRES_DB=dealhunter
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- Internal API key: the web container sends it server-side; the browser never sees it ---
API_KEY=change-me-to-another-long-random-string

# --- CardTrader (https://www.cardtrader.com → profile → Settings → API) ---
# Empty = MOCK mode with illustrative sample data.
CARDTRADER_API_TOKEN=
CARDTRADER_MOCK=auto

# --- Telegram (@BotFather → token; message the bot, then /getUpdates → chat id) ---
# Empty = dry-run (messages are logged, not sent).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DRY_RUN=auto

# --- Dashboard basic auth (optional but recommended if reachable from other devices) ---
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Ports are bound to this address on the host. 127.0.0.1 = only this machine.
# Use your Tailscale IP (100.x.y.z) to expose via Tailscale only. Avoid 0.0.0.0.
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_PORT=8000

LOG_LEVEL=INFO
